TELEGRAM_BOT_TOKEN=123456:ABCDEF_your_token_here

# Recommended: secret salt used to derive non-identifying sticker set names
FEEL_STICKER_SALT=change_me_to_a_long_random_string

# Optional: path to a font file that supports Chinese
FEEL_FONT_PATH=./HanYiChaoCuYuanJian-1.ttf

# Optional: base image path
FEEL_BASE_IMAGE=./pic.jpeg

# Optional: limit user text length to avoid expensive rendering
FEEL_MAX_TEXT_LEN=80

# Optional: limit concurrent renders
FEEL_RENDER_CONCURRENCY=2
